{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$(git rev-parse --show-toplevel)/.codex/hooks/dangerous-cmd-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "zsh \"$(git rev-parse --show-toplevel)/.codex/hooks/ui-review-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking UI contract review"
          },
          {
            "type": "command",
            "command": "zsh \"$(git rev-parse --show-toplevel)/.codex/hooks/tdd-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking test coverage"
          }
        ]
      }
    ]
  }
}
